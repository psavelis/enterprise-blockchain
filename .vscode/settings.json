{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[solidity]": {
    "editor.defaultFormatter": "JuanBlanco.solidity"
  },
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["typescript", "javascript"],
  "prettier.configPath": ".prettierrc.json",
  "prettier.ignorePath": ".prettierignore",
  "files.exclude": {
    "**/node_modules": true,
    "contracts/solidity/out": true,
    "contracts/solidity/cache": true,
    "contracts/solidity/lib": true,
    "contracts/fabric/node_modules": true,
    "dist": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "contracts/solidity/lib": true,
    "contracts/solidity/out": true,
    "contracts/solidity/cache": true,
    "contracts/fabric/node_modules": true,
    "dist": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "contracts/solidity/lib/**": true,
    "contracts/solidity/out/**": true,
    "contracts/solidity/cache/**": true,
    "contracts/fabric/node_modules/**": true,
    "dist/**": true
  },
  "typescript.preferences.importModuleSpecifier": "relative",

  // Solidity extension settings
  "solidity.compileUsingRemoteVersion": "v0.8.24+commit.e11b9ed9",
  "solidity.packageDefaultDependenciesContractsDirectory": "src",
  "solidity.packageDefaultDependenciesDirectory": "lib",
  "solidity.remappings": [
    "forge-std/=contracts/solidity/lib/forge-std/src/",
    "@openzeppelin/contracts/=contracts/solidity/lib/openzeppelin-contracts/contracts/",
    "@openzeppelin/contracts-upgradeable/=contracts/solidity/lib/openzeppelin-contracts-upgradeable/contracts/"
  ],
  // Exclude submodule test/script files from Solidity analysis
  "solidity.sources": "contracts/solidity/src",

  // Wake extension settings - exclude submodules
  "wake.compiler.solc.remappings": [
    "forge-std/=contracts/solidity/lib/forge-std/src/",
    "@openzeppelin/contracts/=contracts/solidity/lib/openzeppelin-contracts/contracts/",
    "@openzeppelin/contracts-upgradeable/=contracts/solidity/lib/openzeppelin-contracts-upgradeable/contracts/"
  ],
  "wake.compiler.solc.exclude": [
    "contracts/solidity/lib/**/test/**",
    "contracts/solidity/lib/**/tests/**",
    "contracts/solidity/lib/**/scripts/**",
    "contracts/solidity/lib/**/script/**",
    "contracts/solidity/lib/**/certora/**",
    "contracts/solidity/lib/**/mocks/**"
  ]
}
