graph LR
    subgraph "Party Inputs — never disclosed"
        A[Supplier A<br/>bid: sealed]
        B[Supplier B<br/>bid: sealed]
        C[Supplier C<br/>bid: sealed]
    end

    A -->|additive share| MPC
    B -->|additive share| MPC
    C -->|additive share| MPC

    subgraph "MPCEngine"
        MPC[aggregate computation<br/>sum · threshold]
        MPC --> SR[SumResult<br/>op: sum, aggregate: N]
        MPC --> TR[ThresholdResult<br/>op: threshold, exceeded: bool]
    end

    SR --> ANC[commitment hash<br/>on-ledger anchor]
    TR --> ANC
