{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "docker compose up -d mock-prover && STONE_PROVER_URL=http://localhost:10000 ENABLE_REAL_PROVER=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prover": "ENABLE_REAL_PROVER=true STONE_PROVER_URL=http://localhost:10000 playwright test --reporter=html,json --output=e2e-results",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:prover": "docker compose up -d mock-prover",
    "docker:prover:logs": "docker compose logs -f mock-prover",
    "docker:full": "docker compose -f docker-compose.full.yml up -d",
    "docker:full:build": "docker compose -f docker-compose.full.yml up -d --build",
    "docker:full:down": "docker compose -f docker-compose.full.yml down -v",
    "docker:full:logs": "docker compose -f docker-compose.full.yml logs -f",
    "test:e2e:full": "docker compose -f docker-compose.full.yml up -d && npm run test:e2e && docker compose -f docker-compose.full.yml down"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.3"
  }
}
