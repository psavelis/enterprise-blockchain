# Enterprise Blockchain - Environment Configuration
# Copy to .env and customize for your environment.
# Ref: https://docs.docker.com/compose/environment-variables/

# ── Telemetry Configuration ─────────────────────────────────────────────
# OpenTelemetry exporter endpoint (OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for trace attribution
OTEL_SERVICE_NAME=enterprise-blockchain

# ── Besu Configuration ──────────────────────────────────────────────────
# Local dev-mode RPC endpoint
BESU_RPC_URL=http://localhost:8545

# Chain ID for dev network
BESU_CHAIN_ID=1337

# ── Fabric Configuration ────────────────────────────────────────────────
# Local peer endpoint
FABRIC_PEER_ENDPOINT=localhost:7051

# Organization MSP ID
FABRIC_MSP_ID=Org1MSP

# ── Corda Configuration ─────────────────────────────────────────────────
# Local RPC endpoint for PartyA
CORDA_RPC_ENDPOINT=localhost:10007

# ── Docker Compose Resource Limits ──────────────────────────────────────
# Override default resource limits if needed
# BESU_CPU_LIMIT=1.0
# BESU_MEMORY_LIMIT=1G
# FABRIC_CPU_LIMIT=0.5
# FABRIC_MEMORY_LIMIT=512M

# ── Stone STARK Prover Configuration ────────────────────────────────────
# gRPC endpoint for the Stone prover service
STONE_PROVER_ENDPOINT=localhost:10000

# Proof generation timeout in milliseconds (5 minutes default)
STONE_PROVER_TIMEOUT_MS=300000

# Path to compiled Cairo circuit artifacts
CAIRO_ARTIFACTS_PATH=./cairo/artifacts

# Maximum concurrent proof generation jobs
STONE_PROVER_MAX_JOBS=4

# Log level for the prover (trace, debug, info, warn, error)
STONE_PROVER_LOG_LEVEL=info
